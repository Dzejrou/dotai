[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/CombatLogPanel.cs" id="1_combat_log_panel_script"]

[node name="CombatLogPanel" type="Control"]
visible = false
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("1_combat_log_panel_script")

[node name="Panel" type="PanelContainer" parent="."]
custom_minimum_size = Vector2(360, 180)
mouse_filter = 2

[node name="Margin" type="MarginContainer" parent="Panel"]
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 8

[node name="Rows" type="VBoxContainer" parent="Panel/Margin"]
theme_override_constants/separation = 2
